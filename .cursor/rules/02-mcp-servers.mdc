### Эвристика тональности (БЕЗ LLM)

```python
# Ключевые слова для классификации тональности:
POSITIVE_WORDS = {
    "рост", "растёт", "повысил", "прибыль", "дивиденды", "рекорд", 
    "превысил", "расширяет", "инвестирует", "позитивный", "улучшение"
}
NEGATIVE_WORDS = {
    "падение", "снижение", "убыток", "риск", "санкции", "штраф",
    "дефолт", "банкротство", "сокращение", "кризис", "негативный"
}

def _classify_sentiment(text: str) -> str:
    """Простая эвристическая классификация. НЕ использовать LLM."""
    text_lower = text.lower()
    pos = sum(1 for w in POSITIVE_WORDS if w in text_lower)
    neg = sum(1 for w in NEGATIVE_WORDS if w in text_lower)
    if pos > neg:
        return "positive"
    elif neg > pos:
        return "negative"
    return "neutral"
```

### Критически важно: НЕ вызывать LLM из news_server

Сервер news_server НЕ должен делать вызовы к OpenAI/Anthropic API.  
Тональность — только эвристика. Иначе возникнет рекурсия (LLM вызывает инструмент → инструмент вызывает LLM).

## analytics_server — правила

### ClickHouse клиент (read-only)

```python
import clickhouse_connect
from config.settings import get_settings

def get_clickhouse_client():
    """Создание read-only клиента ClickHouse."""
    settings = get_settings()
    
    if settings.use_mock_clickhouse:
        return MockClickHouseClient()  # Для тестов/dev
    
    return clickhouse_connect.get_client(
        host=settings.clickhouse_host,
        port=settings.clickhouse_port,
        database=settings.clickhouse_database,
        username=settings.clickhouse_user,
        password=settings.clickhouse_password,
        settings={"readonly": 1},  # Принудительный read-only
        connect_timeout=5,
        query_limit=1000,
    )

# ClickHouse user в профиле должен иметь: SET readonly = 1
```

### SQL-безопасность (обязательно для execute_analytics_query)

```python
import sqlglot
from fastmcp import ToolError

FORBIDDEN_STATEMENTS = {"INSERT", "UPDATE", "DELETE", "DROP", "CREATE", 
                         "ALTER", "TRUNCATE", "RENAME", "ATTACH", "DETACH"}

def _validate_query(query: str) -> str:
    """Валидация SQL-запроса через AST. Возвращает очищенный запрос."""
    # 1. Парсинг AST
    try:
        ast = sqlglot.parse_one(query, dialect="clickhouse")
    except Exception as e:
        raise ToolError(f"Некорректный SQL: {e}")
    
    # 2. Проверка типа запроса
    if not isinstance(ast, sqlglot.exp.Select):
        raise ToolError("Разрешены только SELECT-запросы")
    
    # 3. Проверка отсутствия запрещённых конструкций
    query_upper = query.upper()
    for stmt in FORBIDDEN_STATEMENTS:
        if stmt in query_upper:
            raise ToolError(f"Запрещённая конструкция: {stmt}")
    
    # 4. Добавление LIMIT если отсутствует
    if "LIMIT" not in query_upper:
        query = query.rstrip(";") + " LIMIT 1000"
    
    return query
```

### Расчёт риск-метрик

```python
import numpy as np

def calculate_var(returns: np.ndarray, confidence: float = 0.95) -> float:
    """Историческое VaR (Value at Risk).
    
    Args:
        returns: Массив дневных доходностей (log returns)
        confidence: Доверительный уровень (0.95 = 95%)
    
    Returns:
        VaR в процентах (отрицательное число = убыток)
    """
    return float(np.percentile(returns, (1 - confidence) * 100))

def calculate_cvar(returns: np.ndarray, confidence: float = 0.95) -> float:
    """Conditional VaR (Expected Shortfall)."""
    var = calculate_var(returns, confidence)
    tail_returns = returns[returns <= var]
    return float(np.mean(tail_returns)) if len(tail_returns) > 0 else var

def calculate_beta(stock_returns: np.ndarray, index_returns: np.ndarray) -> float:
    """Бета-коэффициент через OLS регрессию."""
    cov = np.cov(stock_returns, index_returns)[0, 1]
    var_index = np.var(index_returns)
    return cov / var_index if var_index != 0 else 1.0

# ВАЖНО: все расчёты на numpy, НЕ pandas для производительности
# Конвертировать DataFrame в np.ndarray перед расчётами
```

