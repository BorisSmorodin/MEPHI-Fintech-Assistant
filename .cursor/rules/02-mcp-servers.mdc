# Правила MCP-серверов

## Общая структура каждого MCP-сервера

```python
# servers/{name}_server/server.py
from fastmcp import FastMCP, ToolError
import structlog
from config.settings import get_settings

log = structlog.get_logger()
settings = get_settings()

mcp = FastMCP(
    name="{name}_server",
    instructions="Краткое описание назначения сервера для LLM-оркестратора"
)

# Аннотации по умолчанию для всех инструментов:
# - readOnlyHint=True (только чтение)
# - destructiveHint=False  
# - idempotentHint=True
# - openWorldHint=True (обращается к внешним системам)

@mcp.tool(
    annotations={"readOnlyHint": True, "destructiveHint": False, 
                 "idempotentHint": True, "openWorldHint": True}
)
async def tool_name(param: str) -> dict:
    """Описание инструмента для LLM. Указывать:
    - что делает инструмент
    - какие параметры принимает
    - что возвращает
    - возможные ошибки
    """
    log.info("mcp_tool_called", tool="tool_name", param=param)
    try:
        result = await _fetch_data(param)
        return result
    except ToolError:
        raise  # Пробрасывать ToolError без изменений
    except Exception as e:
        log.error("unexpected_error", tool="tool_name", error=str(e))
        raise ToolError(f"Внутренняя ошибка: {e}")

if __name__ == "__main__":
    mcp.run()  # stdio транспорт по умолчанию
```

