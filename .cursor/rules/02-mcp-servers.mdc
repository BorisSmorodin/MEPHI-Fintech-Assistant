### Кэширование котировок

```python
import functools
import time

# Простой TTL-кэш в памяти (НЕ redis для прототипа):
_cache: dict[str, tuple[float, Any]] = {}  # key -> (timestamp, value)

def _cache_get(key: str, ttl: int) -> Any | None:
    if key in _cache:
        ts, val = _cache[key]
        if time.time() - ts < ttl:
            return val
    return None

def _cache_set(key: str, value: Any) -> None:
    _cache[key] = (time.time(), value)

# TTL котировок: 60 сек
# TTL исторических данных: 300 сек
# TTL состава досок: 3600 сек
```

### Форматы дат

```python
# Всегда принимать даты как строку "YYYY-MM-DD":
from datetime import date, datetime

def _parse_date(date_str: str) -> date:
    """Парсинг даты из строки YYYY-MM-DD."""
    try:
        return datetime.strptime(date_str, "%Y-%m-%d").date()
    except ValueError:
        raise ToolError(f"Неверный формат даты: {date_str}. Ожидается YYYY-MM-DD")
```

