## E2E тесты (5 сценариев)

```python
# tests/test_e2e.py
import pytest
import time
from orchestrator.graph import get_graph
from orchestrator.state import create_initial_state

@pytest.mark.asyncio
@pytest.mark.parametrize("query,expected_data_keys,expected_servers", [
    (
        "Покажи котировку SBER",
        ["market_data"],
        ["market_server"]
    ),
    (
        "Последние новости по Газпрому",
        ["news_data"],
        ["news_server"]
    ),
    (
        "Оцени риск портфеля demo_portfolio",
        ["portfolio_metrics"],
        ["analytics_server"]
    ),
    (
        "Проведи стресс-тест IMOEX -20% для портфеля demo_portfolio",
        ["portfolio_metrics"],
        ["analytics_server"]
    ),
    (
        "Оцени портфель demo_portfolio с учётом новостей нефтегазового сектора",
        ["market_data", "news_data", "portfolio_metrics"],
        ["market_server", "news_server", "analytics_server"]
    ),
])
async def test_e2e_scenario(query, expected_data_keys, expected_servers,
                             mock_apimoex, mock_feedparser, mock_clickhouse):
    """E2E тест: система завершает обработку без исключений."""
    graph = get_graph()
    initial_state = create_initial_state(query)
    
    start_time = time.time()
    result = await graph.ainvoke(
        initial_state,
        config={"recursion_limit": 10, "configurable": {"thread_id": "test"}}
    )
    elapsed = time.time() - start_time
    
    # Базовые проверки:
    assert result["final_answer"] is not None, "Ответ не должен быть None"
    assert len(result["final_answer"]) > 10, "Ответ слишком короткий"
    assert result["error_count"] < 3, f"Слишком много ошибок: {result['error_count']}"
    
    # Проверка заполнения нужных полей:
    for key in expected_data_keys:
        assert result[key], f"Поле {key} не заполнено"
    
    # Логирование метрик для главы 4:
    print(f"\n[METRIC] query={query!r}")
    print(f"[METRIC] success=True")
    print(f"[METRIC] response_time={elapsed:.2f}s")
    print(f"[METRIC] error_count={result['error_count']}")
```

## Безопасность — чек-лист

Перед каждым PR/commit проверить:

- [ ] `.env` в `.gitignore`
- [ ] Нет хардкоданных ключей, паролей, токенов в коде
- [ ] `execute_analytics_query` использует `_validate_query` перед исполнением
- [ ] ClickHouse-клиент подключается только с `readonly=1`
- [ ] Пользовательский ввод не встраивается в SQL через f-string
- [ ] Длина пользовательского запроса ограничена (≤ 2000 символов в `input_node`)
- [ ] Новостные данные экранированы перед передачей в LLM (в `prompts.py`)
- [ ] Нет `except Exception: pass` (все ошибки логируются)
- [ ] `ToolError` не раскрывает внутренние детали реализации пользователю

## Метрики для Главы 4 диплома

При тестировании обязательно собирать и сохранять:

```python
# В conftest.py или отдельном модуле:
test_metrics = []

def record_metric(scenario: str, success: bool, correct_tools: bool,
                  response_time: float, mcp_calls: int, error_count: int):
    test_metrics.append({
        "scenario": scenario,
        "scenario_success_rate": success,
        "tool_selection_correct": correct_tools,
        "response_time_sec": response_time,
        "mcp_calls_count": mcp_calls,
        "mttr_applicable": error_count > 0,
        "final_error_count": error_count,
    })

# После тестов — экспорт в CSV для анализа в Главе 4:
import csv
def export_metrics(filename: str = "test_results.csv"):
    with open(filename, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=test_metrics[0].keys())
        writer.writeheader()
        writer.writerows(test_metrics)
```
