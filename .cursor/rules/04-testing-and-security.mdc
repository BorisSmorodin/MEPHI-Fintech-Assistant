        assert _classify_query_type("Покажи котировку SBER") == "market_monitor"
    
    def test_news_analysis_classification(self):
        assert _classify_query_type("Последние новости по Газпрому") == "news_analysis"
    
    def test_risk_assessment_classification(self):
        assert _classify_query_type("Оцени риск моего портфеля VaR") == "risk_assessment"
    
    def test_complex_classification(self):
        q = "Оцени риск портфеля с учётом последних новостей"
        assert _classify_query_type(q) == "complex"
    
    def test_unknown_defaults_to_complex(self):
        assert _classify_query_type("Привет") == "complex"

class TestTickerExtraction:
    def test_extracts_known_ticker(self):
        tickers = _extract_tickers("Покажи цену акции SBER и LKOH")
        assert "SBER" in tickers
        assert "LKOH" in tickers
    
    def test_ignores_unknown(self):
        tickers = _extract_tickers("Цена акции UNKNOWN123")
        assert "UNKNOWN123" not in tickers
