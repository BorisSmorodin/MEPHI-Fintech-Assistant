## Юнит-тесты market_server

```python
# servers/market_server/tests/test_market.py
import pytest
from fastmcp import ToolError

class TestGetStockQuote:
    @pytest.mark.asyncio
    async def test_valid_ticker_returns_quote(self, mock_apimoex):
        from servers.market_server.server import get_stock_quote
        result = await get_stock_quote("SBER")
        assert result["SECID"] == "SBER"
        assert "LAST" in result
        assert isinstance(result["LAST"], float)
    
    @pytest.mark.asyncio
    async def test_invalid_ticker_raises_tool_error(self, mock_apimoex):
        from servers.market_server.server import get_stock_quote
        with pytest.raises(ToolError, match="не найден"):
            await get_stock_quote("INVALID")
    
    @pytest.mark.asyncio
    async def test_caching_returns_same_result(self, mock_apimoex):
        from servers.market_server.server import get_stock_quote
        result1 = await get_stock_quote("SBER")
        result2 = await get_stock_quote("SBER")
        assert result1 == result2
        # apimoex вызывается только один раз благодаря кэшу:
        # (зависит от реализации кэша)

class TestGetCandles:
    @pytest.mark.asyncio
    async def test_returns_ohlcv_list(self, mock_apimoex):
        from servers.market_server.server import get_candles
        result = await get_candles("SBER", "2025-01-01", "2025-12-31", interval=24)
        assert isinstance(result, list)
        assert len(result) > 0
        assert all(k in result[0] for k in ["begin", "open", "high", "low", "close", "volume"])
    
    @pytest.mark.asyncio
    async def test_invalid_date_format_raises_error(self):
        from servers.market_server.server import get_candles
        with pytest.raises(ToolError, match="Неверный формат"):
            await get_candles("SBER", "01-01-2025", "31-12-2025")
